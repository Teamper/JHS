{
  "name": "jhs-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit",
    "test": "node --import ../../scripts/register-shared-packages.mjs --disable-warning=ExperimentalWarning --test tests/*.test.ts ../../packages/shared-parsers/tests/*.test.mjs",
    "test:preview": "node tests/preview.smoke.mjs",
    "bundle:android": "expo export --platform android --output-dir build/android",
    "bundle:ios": "expo export --platform ios --output-dir build/ios",
    "bundle:preview": "expo export --platform web --output-dir build/web"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@noble/hashes": "2.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.108.4",
    "@xmldom/xmldom": "0.9.12",
    "base64-js": "1.5.1",
    "cheerio": "1.1.2",
    "expo": "57.0.33",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.5",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.26",
    "expo-sqlite": "~57.0.5",
    "expo-video": "~57.0.5",
    "lucide-react-native": "^1.78.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "5.9.3"
  }
