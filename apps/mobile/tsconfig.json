{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@jhs/core": [
        "../../packages/shared-core/index.js"
      ],
      "@jhs/fixtures": [
        "../../packages/shared-fixtures/fixtures.js"
      ],
      "@jhs/fixtures/*": [
        "../../packages/shared-fixtures/*"
      ],
      "@jhs/parsers": [
        "../../packages/shared-parsers/index.js"
      ]
    }
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../src/contracts/legacy-globals.d.ts"
  ]
}
