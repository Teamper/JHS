{
  "name": "jhs-userscript",
  "version": "6.5.2",
  "description": "JAV Helper Suite for JavDB and JavBus",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Teamper/JHS.git"
  },
  "bugs": {
    "url": "https://github.com/Teamper/JHS/issues"
  },
  "homepage": "https://github.com/Teamper/JHS#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-dev.mjs",
    "build:dev": "node scripts/build-dev.mjs",
    "build:dev:deliver": "node scripts/build-dev.mjs --deliver",
    "check:performance:serial": "node scripts/check-serial-performance.mjs",
    "check:dev:delivery": "node scripts/check-dev-delivery.mjs",
    "analyze:bundle": "node scripts/analyze-bundle-size.mjs",
    "build:rc": "node scripts/build-rc.mjs",
    "check:rc": "node scripts/check-rc.mjs",
    "check:release:notes": "node scripts/check-release-notes.mjs",
    "release:notes:context": "node scripts/release-notes-context.mjs",
    "check:rc:delivery": "node scripts/check-rc-delivery.mjs",
    "build:release": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:js": "tsc -p tsconfig.architecture.json && node scripts/checkjs-coverage.mjs",
    "check:architecture": "node scripts/architecture-check.mjs",
    "check:integrations": "node scripts/integration-quality-check.mjs",
    "check:performance": "node scripts/performance-budget-check.mjs",
    "check": "npm run test && npm run build && npm run check:js && npm run check:architecture && npm run check:integrations && npm run check:performance && node scripts/release-contract.mjs && npm run check:release:notes && node scripts/release-invariants.mjs && node scripts/contrast-audit.mjs && node --check dist/dev/JHS-7.0.dev.user.js",
    "check:browser": "npm --prefix tests/browser test",
    "check:visual": "npm --prefix tests/browser run test:visual",
    "check:release": "npm run check && npm run check:browser && npm run check:visual",
    "check:full": "npm run check:release",
    "check:mobile": "npm --prefix apps/mobile run check && npm --prefix apps/mobile test",
    "build:extension": "node scripts/build-extension.mjs",
    "start:javdb-api": "node scripts/javdb-api.mjs",
    "build:android:web": "node scripts/build-android-web.mjs",
    "build:android:sync": "npm run build:android:web && cap sync android",
    "check:extension:chrome": "node tests/browser/scripts/extension-smoke.mjs --chrome",
    "check:extension:edge": "node tests/browser/scripts/extension-smoke.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@types/chrome": "^0.3.7",
    "blueimp-md5": "^2.19.0",
    "esbuild": "^0.28.0",
    "fflate": "0.8.3",
    "jquery": "^3.7.1",
    "jsdom": "^26.1.0",
    "layui-layer": "^1.0.9",
    "localforage": "^1.10.0",
    "tabulator-tables": "^6.3.1",
    "toastify-js": "^1.12.0",
    "typescript": "5.9.3",
    "viewerjs": "^1.11.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "hls.js": "1.7.4"
  }
}
